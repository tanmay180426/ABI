# ==============================================================================
# Autonomous Business Intelligence Platform (ABI) - Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
# Set to false to disable login requirement on the frontend (development only).
# Default when unset: true (login required).
VITE_AUTH_REQUIRED=true

# ------------------------------------------------------------------------------
# Backend Core & Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection string for production, or SQLite path for local testing
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sem5_bi
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ENV=dev

# ------------------------------------------------------------------------------
# Authentication / RBAC Configuration
# ------------------------------------------------------------------------------
# Two roles supported: admin and analyst
# When true (the default), all protected routes require a valid Bearer token.
AUTH_REQUIRED=true
AUTH_ADMIN_PASSWORD=admin123
AUTH_ANALYST_PASSWORD=analyst123

# ------------------------------------------------------------------------------
# AI Assistant (Optional local LLM; falls back to deterministic summary)
# ------------------------------------------------------------------------------
ENABLE_LLM_ASSISTANT=false
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=20

# ------------------------------------------------------------------------------
# Dataset & Batch Ingestion Limits
# ------------------------------------------------------------------------------
# Max size per individual dataset file in bytes (default: 100 MB = 104857600)
DATASET_MAX_BYTES=104857600
# Max compressed ZIP archive size in bytes (default: 500 MB = 524288000)
DATASET_MAX_ZIP_BYTES=524288000
# Max files per multi-upload batch (default: 100)
DATASET_MAX_BATCH_FILES=100
# Max total batch upload payload in bytes (default: 600 MB = 629145600)
DATASET_MAX_BATCH_BYTES=629145600
# Max extracted archive content in bytes (default: 1 GB = 1073741824)
DATASET_MAX_EXTRACTED_BYTES=1073741824
# Max extracted files per ZIP archive (default: 2000)
DATASET_MAX_EXTRACTED_FILES=2000
# Ingestion row, column, and cell limits
DATASET_MAX_ROWS=1000000
DATASET_MAX_COLUMNS=100
DATASET_MAX_CELLS=20000000
DATASET_MAX_SECONDS=300
